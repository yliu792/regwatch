def _get_scraper(source: str):
    cls = _scraper_registry.get(source)
    if cls is None:
        raise HTTPException(
            status_code=400,
            detail=f"Unknown source '{source}'. Available: {sorted(_scraper_registry)}",
        )
    return cls()


