# ── systemd unit for RegWatch (bare-metal EC2) ─────────────────────
# Installation:
#   sudo cp deploy/regwatch.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now regwatch

[Unit]
Description=RegWatch — regulatory change watcher
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=regwatch
Group=regwatch
WorkingDirectory=/opt/regwatch
EnvironmentFile=/opt/regwatch/.env
ExecStart=/opt/regwatch/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --log-level info \
    --no-access-log
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
